```html
<!DOCTYPE html>
<html>
<head>
    <title>Trang đăng nhập</title>

    <style>
        body {
            background: #f0f2f5;
            font-family: Arial;
            text-align: center;
            margin-top: 120px;
        }

        h1 {
            color: #1877f2;
            font-size: 50px;
        }

        .login-box {
            background: white;
            width: 350px;
            margin: auto;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 2px 10px #ccc;
        }

        input {
            width: 90%;
            padding: 14px;
            margin: 7px;
            font-size: 16px;
            border: 1px solid #ddd;
            border-radius: 6px;
        }

        button {
            width: 95%;
            padding: 13px;
            margin-top: 10px;
            background: #1877f2;
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 18px;
            cursor: pointer;
        }

        button:hover {
            background: #166fe5;
        }

        #thongbao {
            margin-top: 15px;
        }
    </style>
</head>

<body>

    <h1>Facebook</h1>

    <div class="login-box">

        <input type="text" placeholder="Email hoặc số điện thoại">

        <input type="password" placeholder="Mật khẩu">

        <button onclick="dangNhap()">Đăng nhập</button>

        <p id="thongbao"></p>

    </div>

    <script>
        function dangNhap() {
            document.getElementById("thongbao").innerHTML =
                "🎉 Bạn vừa bấm nút Đăng nhập!";
        }
    </script>

</body>
</html>
